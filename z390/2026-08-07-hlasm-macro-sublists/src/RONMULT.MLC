RONMULT  CSECT
*  Inner macro, to observe what a sublist looks like when passed on.
         MACRO
         INNER
         MNOTE *,'  INNER (1)  =>&SYSLIST(1)<'
         MNOTE *,'  INNER (1,1)=>&SYSLIST(1,1)<'
         MEND
*  Multilevel sublist subscripting.  Counts live in RONCNT.MLC.
         MACRO
         MULT
         MNOTE *,'SYSLIST(1)     = >&SYSLIST(1)<'
         MNOTE *,'SYSLIST(2)     = >&SYSLIST(2)<'
         MNOTE *,'SYSLIST(2,1)   = >&SYSLIST(2,1)<'
         MNOTE *,'SYSLIST(2,2)   = >&SYSLIST(2,2)<'
         MNOTE *,'SYSLIST(2,2,1) = >&SYSLIST(2,2,1)<'
         MNOTE *,'SYSLIST(2,2,3) = >&SYSLIST(2,2,3)<'
         MNOTE *,'SYSLIST(2,9)   = >&SYSLIST(2,9)< past end'
         MNOTE *,'SYSLIST(9)     = >&SYSLIST(9)< past end'
         MNOTE *,'SYSLIST(1,1)   = >&SYSLIST(1,1)< not a sublist'
         INNER &SYSLIST(2)
         MEND
*  Named positional parameter carrying a sublist.
         MACRO
         NAMED &P
         MNOTE *,'P=>&P< P(1)=>&P(1)< P(2)=>&P(2)<'
         MEND
*
         MNOTE *,'=== MULT 1,(10,(100,200,300),30),3 ==='
         MULT  1,(10,(100,200,300),30),3
         MNOTE *,'=== omitted entries: MULT 1,(A,,C),3 ==='
         MULT  1,(A,,C),3
         MNOTE *,'=== empty sublist: MULT 1,(),3 ==='
         MULT  1,(),3
         MNOTE *,'=== named parameter: NAMED (X,Y,Z) ==='
         NAMED (X,Y,Z)
         MNOTE *,'=== named parameter, plain: NAMED Q ==='
         NAMED Q
         END
