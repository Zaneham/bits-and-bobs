RONCNT   CSECT
*  N' attribute counts over sublists.  Evaluated via SETA, because an
*  attribute reference is not substituted inside a quoted string.
         MACRO
         CNT
         LCLA  &N0,&N2,&N22,&N1
&N0      SETA  N'&SYSLIST
&N1      SETA  N'&SYSLIST(1)
&N2      SETA  N'&SYSLIST(2)
&N22     SETA  N'&SYSLIST(2,2)
         MNOTE *,'operand 2 = >&SYSLIST(2)<'
         MNOTE *,'  N-SYSLIST=&N0 N(1)=&N1 N(2)=&N2 N(2,2)=&N22'
         MEND
*
         MNOTE *,'=== CNT 1,(10,(100,200,300),30),3 ==='
         CNT   1,(10,(100,200,300),30),3
         MNOTE *,'=== CNT 1,(A,,C),3   omitted middle entry ==='
         CNT   1,(A,,C),3
         MNOTE *,'=== CNT 1,(),3   empty sublist ==='
         CNT   1,(),3
         MNOTE *,'=== CNT 1,PLAIN,3   operand 2 not a sublist ==='
         CNT   1,PLAIN,3
         MNOTE *,'=== CNT 1,(A,B,),3   trailing omitted entry ==='
         CNT   1,(A,B,),3
         END
