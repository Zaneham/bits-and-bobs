+ * in all copies.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL
+ * WARRANTIES WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED
+ * WARRANTIES OF MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE
+ * AUTHOR BE LIABLE FOR ANY SPECIAL, DIRECT, INDIRECT, OR
+ * CONSEQUENTIAL DAMAGES OR ANY DAMAGES WHATSOEVER RESULTING FROM LOSS
+ * OF USE, DATA OR PROFITS, WHETHER IN AN ACTION OF CONTRACT,
+ * NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF OR IN
+ * CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ */
+
+#define ENTRY(x) .text; .globl x; .type x,%function; x:
+#define END(x)   .size x, . - x
+
+/*
+ * a0: stack pointer to use
+ * a1: function to call
+ * a2: argument to pass to function
+ *
+ * No link register to load, so the tail jump is the call. Nothing returns here.
+ */
+ENTRY(spt_launch)
+	mv sp, a0         // load stack pointer
+	mv a0, a2         // parameter to pass to function goes into a0
+	jr a1             // jump to the function
+END(spt_launch)
diff --git a/tests/test_fpu/test_fpu.c b/tests/test_fpu/test_fpu.c
index 6069f37..da11cd8 100644
--- a/tests/test_fpu/test_fpu.c
+++ b/tests/test_fpu/test_fpu.c
@@ -75,6 +75,19 @@ int solo5_app_main(const struct solo5_start_info *si __attribute__((unused)))
     DOMUL(c[2]);
     DOMUL(c[3]);
 #undef DOMUL
+#elif defined(__riscv) && (__riscv_xlen == 64)
+#define DOMUL(VAR)                                                             \
+    __asm__("flw ft0, %0\n"                                                    \
+            "fmul.s ft0, ft0, ft0\n"                                           \
+            "fsw ft0, %0\n"                                                    \
+            : "=m"(VAR)                                                        \
+            : "m"(VAR)                                                         \
+            : "memory")
+    DOMUL(c[0]);
+    DOMUL(c[1]);
+    DOMUL(c[2]);
+    DOMUL(c[3]);
+#undef DOMUL
 #else
 #error Unsupported architecture
 #endif
diff --git a/tests/test_notls/test_notls.c b/tests/test_notls/test_notls.c
index bfa1528..087a52a 100644
--- a/tests/test_notls/test_notls.c
+++ b/tests/test_notls/test_notls.c
@@ -41,6 +41,9 @@ int solo5_app_main(const struct solo5_start_info *si __attribute__((unused)))
                        : "x0", "w1");
 #elif defined(__powerpc64__)
     __asm__ __volatile("ld 3,-28672(13)" : : : "r3", "r13");
+#elif defined(__riscv) && (__riscv_xlen == 64)
+    /* No gap above tp on RISC-V, so the first thread variable is at tp itself. */
+    __asm__ __volatile("ld a0, 0(tp)" : : : "a0");
 #else
 #error Unsupported architecture
 #endif
diff --git a/tests/test_seccomp/test_seccomp.c b/tests/test_seccomp/test_seccomp.c
index e3457f7..e96d20d 100644
--- a/tests/test_seccomp/test_seccomp.c
+++ b/tests/test_seccomp/test_seccomp.c
@@ -54,6 +54,11 @@ int solo5_app_main(const struct solo5_start_info *si __attribute__((unused)))
     register long r3 __asm__("r3") = 0;
 
     __asm__ __volatile__("sc" : "=r"(r3) : "r"(r0), "r"(r3) : "cc", "memory");
+#elif defined(__riscv) && (__riscv_xlen == 64)
+    register long a7 __asm__("a7") = 23;
+    register long a0 __asm__("a0") = 1;
+
+    __asm__ __volatile__("ecall" : "+r"(a0) : "r"(a7) : "memory");
 #else
 #error Unsupported architecture
 #endif
