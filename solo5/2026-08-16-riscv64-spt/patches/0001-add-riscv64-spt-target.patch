+ * OF USE, DATA OR PROFITS, WHETHER IN AN ACTION OF CONTRACT,
+ * NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF OR IN
+ * CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ */
+#ifndef __CPU_RISCV64_H__
+#define __CPU_RISCV64_H__
+
+/* memory defines */
+#define PAGE_SIZE  4096
+#define PAGE_SHIFT 12
+#define PAGE_MASK  ~(0xfff)
+
+#ifndef ASM_FILE
+
+/*
+ * The remainder of this file is used only from C.
+ */
+static inline uint64_t cpu_cntvct(void)
+{
+    uint64_t val;
+
+    /* rdtime and not rdcycle, which Linux leaves trapping in U-mode. */
+    __asm__ __volatile__("rdtime %0" : "=r"(val));
+
+    return val;
+}
+
+static inline void cpu_set_tls_base(uint64_t base)
+{
+    __asm__ __volatile__("mv tp, %0" : : "r"(base));
+}
+
+#endif /* !ASM_FILE */
+
+#endif /* __CPU_RISCV64_H__ */
