From <commit> Mon Sep 17 00:00:00 2001
From: <author>
Date: 2026-08-12
Subject: [PATCH] asmcomp: make atomic compare-exchange the primitive, derive
 compare-and-set

The instruction already reports the value it found, so returning that and
testing it in cmmgen replaces the per-backend boolean materialisation.
---
 asmcomp/CSEgen.ml           |  2 +-
 asmcomp/amd64/emit.mlp      | 25 +++++++++++++------------
 asmcomp/amd64/selection.ml  |  6 +++---
 asmcomp/arm64/emit.mlp      | 11 +++++------
 asmcomp/arm64/proc.ml       |  5 +++--
 asmcomp/cmm.ml              |  2 +-
 asmcomp/cmm.mli             |  4 +++-
 asmcomp/cmmgen.ml           | 20 ++++++++++++++------
 asmcomp/interf.ml           |  2 +-
 asmcomp/mach.ml             |  4 ++--
 asmcomp/mach.mli            |  2 +-
 asmcomp/polling.ml          |  2 +-
 asmcomp/power/emit.mlp      | 19 ++++++++-----------
 asmcomp/printcmm.ml         |  2 +-
 asmcomp/printmach.ml        |  5 +++--
 asmcomp/riscv/emit.mlp      | 23 ++++++++++-------------
 asmcomp/s390x/emit.mlp      | 20 ++++++++------------
 asmcomp/schedgen.ml         |  2 +-
 asmcomp/selectgen.ml        |  8 ++++----
 asmcomp/thread_sanitizer.ml |  7 ++++---
 20 files changed, 87 insertions(+), 84 deletions(-)

diff --git a/asmcomp/CSEgen.ml b/asmcomp/CSEgen.ml
index ff722d75ab..cb056bf17f 100644
--- a/asmcomp/CSEgen.ml
+++ b/asmcomp/CSEgen.ml
@@ -237,7 +237,7 @@ method class_of_operation op =
       if is_atomic then Op_store true
       else Op_load mutability
   | Istore(_,_,asg) -> Op_store asg
-  | Iatomic_fetch_add | Iatomic_exchange | Iatomic_cas ->
+  | Iatomic_fetch_add | Iatomic_exchange | Iatomic_compare_exchange ->
       Op_store true  (* atomic read-modify-write *)
   | Ialloc _ | Ipoll _ -> assert false     (* treated specially *)
   | Iintop(Icheckbound) -> Op_checkbound
diff --git a/asmcomp/amd64/emit.mlp b/asmcomp/amd64/emit.mlp
index a950b8deb3..e767242be0 100644
--- a/asmcomp/amd64/emit.mlp
+++ b/asmcomp/amd64/emit.mlp
@@ -773,28 +773,29 @@ let emit_instr env fallthrough i =
       def_label lbl_multi;
       I.xchg (res i 0) (mem64 QWORD 0 (arg64 i 0));
       def_label lbl_done
-  | Lop (Iatomic_cas) ->
-      (* rax holds the expected value on entry. A lone domain does the compare
-         and the store by hand through res.(1): an unlocked cmpxchg would
-         still serialise on the same port, the same reason fetch-and-add does
-         not use an unlocked xadd here. mov leaves the flags alone, so both
-         paths reach the setcc with ZF meaning "swapped". *)
+  | Lop (Iatomic_compare_exchange) ->
+      (* rax holds the expected value on entry and cmpxchg overwrites it with
+         whatever it found, which is exactly the result, so the locked path
+         needs nothing after it. A lone domain does the compare and the store
+         by hand through res.(1): an unlocked cmpxchg would still serialise on
+         the same port, the same reason fetch-and-add does not use an unlocked
+         xadd here. That path has to copy the value it loaded into rax itself,
+         since rax is still holding the expected value. *)
       let lbl_multi = new_label() in
+      let lbl_stored = new_label() in
       let lbl_done = new_label() in
       I.cmp (int 1) (mem64 QWORD 0 (arg64 i 3));
       I.jne (label lbl_multi);
       I.mov (mem64 QWORD 0 (arg64 i 0)) (res i 1);
       I.cmp (res i 1) (arg i 1);
-      I.jne (label lbl_done);
+      I.jne (label lbl_stored);
       I.mov (arg i 2) (mem64 QWORD 0 (arg64 i 0));
+      def_label lbl_stored;
+      I.mov (res i 1) (res i 0);
       I.jmp (label lbl_done);
       def_label lbl_multi;
       I.lock_cmpxchg (arg i 2) (mem64 QWORD 0 (arg64 i 0));
-      def_label lbl_done;
-      (* res.(0) is rax, so al is free to take ZF before we widen it. cmmgen
-         tags the 0/1 the same way it tags any other comparison. *)
-      I.set E al;
-      I.movzx al (res i 0)
+      def_label lbl_done
   | Lop (Ireturn_addr) ->
       let offset = frame_size env - 8 in
       I.mov (mem64 QWORD offset RSP) (res i 0)
diff --git a/asmcomp/amd64/selection.ml b/asmcomp/amd64/selection.ml
index f166f1aa7c..9890d70d28 100644
--- a/asmcomp/amd64/selection.ml
+++ b/asmcomp/amd64/selection.ml
@@ -141,7 +141,7 @@ let pseudoregs_for_operation op arg res =
      res.(1) is a scratch for the single-domain path, which loads and stores
      by hand rather than paying for a cmpxchg it does not need.
      arg.(3) is &caml_num_domains_running. *)
-  | Iatomic_cas ->
+  | Iatomic_compare_exchange ->
       let treg = Reg.create Int in
       ([| arg.(0); rax; arg.(2); arg.(3) |], [| rax; treg |])
   (* Other instructions are regular *)
@@ -287,8 +287,8 @@ method! select_operation op args dbg =
   | Catomic_exchange ->
       (Iatomic_exchange,
        args @ [Cconst_symbol ("caml_num_domains_running", dbg)])
-  | Catomic_cas ->
-      (Iatomic_cas,
+  | Catomic_compare_exchange ->
+      (Iatomic_compare_exchange,
        args @ [Cconst_symbol ("caml_num_domains_running", dbg)])
   | _ -> super#select_operation op args dbg
 
diff --git a/asmcomp/arm64/emit.mlp b/asmcomp/arm64/emit.mlp
index cdb140bf11..723259fcae 100644
--- a/asmcomp/arm64/emit.mlp
+++ b/asmcomp/arm64/emit.mlp
@@ -544,7 +544,7 @@ module Size = struct
     | Lop (Idls_get) -> 1
     | Lop (Iatomic_fetch_add) -> 5
     | Lop (Iatomic_exchange) -> 4
-    | Lop (Iatomic_cas) -> 9
+    | Lop (Iatomic_compare_exchange) -> 8
     | Lop (Ireturn_addr) -> 1
     | Lreloadretaddr -> 0
     | Lreturn -> epilogue_size f + (if top_bits_ignore then 0 else 1)
@@ -1049,10 +1049,10 @@ let emit_instr env i =
         `	stlxr	{emit_wreg reg_tmp2}, {emit_reg i.arg.(1)}, [{emit_reg i.arg.(0)}]\n`;
         `	cbnz	{emit_wreg reg_tmp2}, {emit_label lbl}\n`;
         `	dmb	ishst\n`
-    | Lop(Iatomic_cas) ->
-        (* res.(0) holds the loaded value until the very end, where cset
-           overwrites it with the result. The flags set by cmp survive stlxr,
-           cbnz, b and clrex, so both paths land on the same cset.
+    | Lop(Iatomic_compare_exchange) ->
+        (* res.(0) is the loaded value and now simply stays that way, which is
+           what the operation returns. Both paths still join at the release
+           barrier.
            clrex is not architecturally required for an abandoned ldaxr (ARM
            ARM B2.10.5) but drops the monitor rather than leaving it marked. *)
         let lbl = new_label() in
@@ -1068,7 +1068,6 @@ let emit_instr env i =
         `{emit_label lbl_fail}:\n`;
         `	clrex\n`;
         `{emit_label lbl_done}:\n`;
-        `	cset	{emit_reg i.res.(0)}, eq\n`;
         `	dmb	ishst\n`
     | Lop(Iatomic_fetch_add) ->
         (* LL/SC loop, works on baseline ARMv8.0 (no LSE required).
diff --git a/asmcomp/arm64/proc.ml b/asmcomp/arm64/proc.ml
index d566328da8..979cb97960 100644
--- a/asmcomp/arm64/proc.ml
+++ b/asmcomp/arm64/proc.ml
@@ -271,7 +271,7 @@ let destroyed_at_oper = function
       [| reg_d7 |]            (* d7 / s7 destroyed *)
   | Iop(Iatomic_fetch_add) ->
       [| reg_x16; reg_x17 |]  (* x16=sum, x17=stlxr status in LL/SC loop *)
-  | Iop(Iatomic_exchange | Iatomic_cas) ->
+  | Iop(Iatomic_exchange | Iatomic_compare_exchange) ->
       [| reg_x17 |]           (* x17=stlxr status in LL/SC loop *)
   | _ -> [||]
 
@@ -292,7 +292,8 @@ let max_register_pressure = function
   | Iintoffloat | Ifloatofint
   | Iload{memory_chunk=Single; _} | Istore(Single, _, _) -> [| 23; 31 |]
   | Iatomic_fetch_add -> [| 21; 32 |]  (* x16+x17 used as scratch *)
-  | Iatomic_exchange | Iatomic_cas -> [| 22; 32 |]  (* x17 used as scratch *)
+  | Iatomic_exchange | Iatomic_compare_exchange ->
+      [| 22; 32 |]                (* x17 used as scratch *)
   | _ -> [| 23; 32 |]
 
 (* Calling the assembler *)
diff --git a/asmcomp/cmm.ml b/asmcomp/cmm.ml
index 98fb985a8e..2bd59e047c 100644
--- a/asmcomp/cmm.ml
+++ b/asmcomp/cmm.ml
@@ -171,7 +171,7 @@ and operation =
   | Copaque
   | Catomic_fetch_add
   | Catomic_exchange
-  | Catomic_cas
+  | Catomic_compare_exchange
   | Cdls_get
