diff --git a/asmcomp/riscv/emit.mlp b/asmcomp/riscv/emit.mlp
index cc42ba581b..63d97b9586 100644
--- a/asmcomp/riscv/emit.mlp
+++ b/asmcomp/riscv/emit.mlp
@@ -545,25 +545,22 @@ let emit_instr env i =
   | Lop (Iatomic_exchange) ->
       (* amoswap.d.aqrl carries both orderings, same as amoadd below. *)
       `	amoswap.d.aqrl	{emit_reg i.res.(0)}, {emit_reg i.arg.(1)}, ({emit_reg i.arg.(0)})\n`
-  | Lop (Iatomic_cas) ->
-      (* The canonical sequence from the ISA manual, section 14.3. res.(0)
-         carries the loaded value, then the sc status, then the result, which
-         keeps the loop inside the constrained-LR/SC limits: no loads, stores
-         or backward branches between the lr and the sc.
+  | Lop (Iatomic_compare_exchange) ->
+      (* The canonical sequence from the ISA manual, section 14.3. res.(0) has
+         to hold the loaded value all the way out now that it is the result,
+         so the sc status goes to reg_tmp instead of borrowing res.(0). t1 is
+         above num_available_registers so it is never allocated, and nothing
+         between the lr and the sc loads, stores or branches backwards, which
+         keeps the loop inside the constrained-LR/SC limits.
          aqrl on the lr and rl on the sc is the seq_cst mapping. The manual
          warns against rl on an lr without aq, and aq on an sc without rl. *)
       let lbl = new_label() in
-      let lbl_fail = new_label() in
       let lbl_done = new_label() in
       `{emit_label lbl}:\n`;
       `	lr.d.aqrl	{emit_reg i.res.(0)}, ({emit_reg i.arg.(0)})\n`;
-      `	bne	{emit_reg i.res.(0)}, {emit_reg i.arg.(1)}, {emit_label lbl_fail}\n`;
-      `	sc.d.rl	{emit_reg i.res.(0)}, {emit_reg i.arg.(2)}, ({emit_reg i.arg.(0)})\n`;
-      `	bnez	{emit_reg i.res.(0)}, {emit_label lbl}\n`;
-      `	li	{emit_reg i.res.(0)}, 1\n`;
-      `	j	{emit_label lbl_done}\n`;
-      `{emit_label lbl_fail}:\n`;
-      `	li	{emit_reg i.res.(0)}, 0\n`;
+      `	bne	{emit_reg i.res.(0)}, {emit_reg i.arg.(1)}, {emit_label lbl_done}\n`;
+      `	sc.d.rl	{emit_reg reg_tmp}, {emit_reg i.arg.(2)}, ({emit_reg i.arg.(0)})\n`;
+      `	bnez	{emit_reg reg_tmp}, {emit_label lbl}\n`;
       `{emit_label lbl_done}:\n`
   | Lop (Iatomic_fetch_add) ->
       (* amoadd.d.aqrl carries both acquire and release ordering, so no
diff --git a/asmcomp/s390x/emit.mlp b/asmcomp/s390x/emit.mlp
index f03b9c369c..c72a4cc818 100644
--- a/asmcomp/s390x/emit.mlp
+++ b/asmcomp/s390x/emit.mlp
@@ -435,19 +435,15 @@ let emit_instr env i =
         `{emit_label lbl}:\n`;
         `	csg	{emit_reg i.res.(0)}, {emit_reg i.arg.(1)}, 0({emit_reg i.arg.(0)})\n`;
         `	brc	4, {emit_label lbl}\n`
-    | Lop(Iatomic_cas) ->
-        (* csg clobbers its first operand on failure, so the expected value is
-           copied into res.(0) first, which interference keeps clear of the
-           arguments. lghi leaves the condition code alone, so the result is
-           materialised the same way as an integer comparison.
-           brc 8 is condition code 0, equal and stored. *)
-        let lbl = new_label() in
+    | Lop(Iatomic_compare_exchange) ->
+        (* csg already reports what it found. On a mismatch it loads the
+           storage value into its first operand, and on a match that operand
+           still holds the expected value, which is the same word. So res.(0)
+           is the answer on both paths and there is nothing left to do.
+           The expected value is copied in first because csg clobbers it, and
+           interference keeps res.(0) clear of the arguments. *)
         `	lgr	{emit_reg i.res.(0)}, {emit_reg i.arg.(1)}\n`;
-        `	csg	{emit_reg i.res.(0)}, {emit_reg i.arg.(2)}, 0({emit_reg i.arg.(0)})\n`;
-        `	lghi	{emit_reg i.res.(0)}, 1\n`;
-        `	brc	8, {emit_label lbl}\n`;
-        `	lghi	{emit_reg i.res.(0)}, 0\n`;
-        `{emit_label lbl}:\n`
+        `	csg	{emit_reg i.res.(0)}, {emit_reg i.arg.(2)}, 0({emit_reg i.arg.(0)})\n`
     | Lop(Iatomic_fetch_add) ->
         `	laag	{emit_reg i.res.(0)}, {emit_reg i.arg.(1)}, 0({emit_reg i.arg.(0)})\n`
 
diff --git a/asmcomp/schedgen.ml b/asmcomp/schedgen.ml
index 6123b0bbb7..376b41e872 100644
--- a/asmcomp/schedgen.ml
+++ b/asmcomp/schedgen.ml
@@ -190,7 +190,7 @@ method private instr_in_basic_block instr try_nesting =
 
 method is_store = function
     Istore(_, _, _) -> true
-  | Iatomic_fetch_add | Iatomic_exchange | Iatomic_cas ->
+  | Iatomic_fetch_add | Iatomic_exchange | Iatomic_compare_exchange ->
       true  (* atomic read-modify-write *)
