diff --git a/asmcomp/selectgen.ml b/asmcomp/selectgen.ml
index a5c9f69081..c51a4d1ced 100644
--- a/asmcomp/selectgen.ml
+++ b/asmcomp/selectgen.ml
@@ -87,7 +87,7 @@ let oper_result_type = function
