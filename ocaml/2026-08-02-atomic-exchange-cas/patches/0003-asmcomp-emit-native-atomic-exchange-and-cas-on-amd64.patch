diff --git a/asmcomp/CSEgen.ml b/asmcomp/CSEgen.ml
index e10dbd09a4..ff722d75ab 100644
--- a/asmcomp/CSEgen.ml
+++ b/asmcomp/CSEgen.ml
@@ -237,7 +237,8 @@ method class_of_operation op =
       if is_atomic then Op_store true
       else Op_load mutability
   | Istore(_,_,asg) -> Op_store asg
-  | Iatomic_fetch_add -> Op_store true  (* atomic read-modify-write *)
+  | Iatomic_fetch_add | Iatomic_exchange | Iatomic_cas ->
+      Op_store true  (* atomic read-modify-write *)
   | Ialloc _ | Ipoll _ -> assert false     (* treated specially *)
   | Iintop(Icheckbound) -> Op_checkbound
   | Iintop _ -> Op_pure
diff --git a/asmcomp/amd64/emit.mlp b/asmcomp/amd64/emit.mlp
index 802207bda5..da13de4a9a 100644
--- a/asmcomp/amd64/emit.mlp
+++ b/asmcomp/amd64/emit.mlp
@@ -758,6 +758,38 @@ let emit_instr env fallthrough i =
       def_label lbl_multi;
       I.lock_xadd (res i 0) (mem64 QWORD 0 (arg64 i 0));
       def_label lbl_done
+  | Lop (Iatomic_exchange) ->
+      (* res.(0) arrives holding the new value and leaves holding the old one.
+         xchg against memory carries an implicit lock, so the single-domain
+         path spells it out as a load and a store through res.(1). *)
+      let lbl_multi = new_label() in
+      let lbl_done = new_label() in
+      I.cmp (int 1) (mem64 QWORD 0 (arg64 i 2));
+      I.jne (label lbl_multi);
+      I.mov (mem64 QWORD 0 (arg64 i 0)) (res i 1);
+      I.mov (res i 0) (mem64 QWORD 0 (arg64 i 0));
+      I.mov (res i 1) (res i 0);
+      I.jmp (label lbl_done);
+      def_label lbl_multi;
+      I.xchg (res i 0) (mem64 QWORD 0 (arg64 i 0));
+      def_label lbl_done
+  | Lop (Iatomic_cas) ->
+      (* rax holds the expected value on entry. cmpxchg sets ZF on success and
+         otherwise loads what it found into rax, which we overwrite anyway.
+         Unlocked cmpxchg has the same semantics for a lone domain. *)
+      let lbl_multi = new_label() in
+      let lbl_done = new_label() in
+      I.cmp (int 1) (mem64 QWORD 0 (arg64 i 3));
+      I.jne (label lbl_multi);
+      I.cmpxchg (arg i 2) (mem64 QWORD 0 (arg64 i 0));
+      I.jmp (label lbl_done);
+      def_label lbl_multi;
+      I.lock_cmpxchg (arg i 2) (mem64 QWORD 0 (arg64 i 0));
+      def_label lbl_done;
+      (* res.(0) is rax, so al is free to take ZF before we widen it. cmmgen
+         tags the 0/1 the same way it tags any other comparison. *)
+      I.set E al;
+      I.movzx al (res i 0)
   | Lop (Ireturn_addr) ->
       let offset = frame_size env - 8 in
       I.mov (mem64 QWORD offset RSP) (res i 0)
diff --git a/asmcomp/amd64/selection.ml b/asmcomp/amd64/selection.ml
index b71fd07c26..d211902250 100644
--- a/asmcomp/amd64/selection.ml
+++ b/asmcomp/amd64/selection.ml
@@ -130,6 +130,17 @@ let pseudoregs_for_operation op arg res =
      no separate mov is needed in emit. arg.(2) is &caml_num_domains_running. *)
   | Iatomic_fetch_add ->
       ([| arg.(0); res.(0); arg.(2) |], res)
+  (* Same trick for exchange, res.(0) carries the new value into the swap and
+     comes back holding the old one. xchg on memory is always locked, so the
+     single-domain path needs a scratch to do it with plain moves instead. *)
+  | Iatomic_exchange ->
+      let treg = Reg.create Int in
+      ([| arg.(0); res.(0); arg.(2) |], [| res.(0); treg |])
+  (* cmpxchg compares against rax and overwrites it with the value it found,
+     so the expected value goes in rax and the tagged result comes back there
+     too. arg.(3) is &caml_num_domains_running. *)
+  | Iatomic_cas ->
+      ([| arg.(0); rax; arg.(2); arg.(3) |], [| rax |])
   (* Other instructions are regular *)
   | _ -> raise Use_default
 
@@ -270,6 +281,12 @@ method! select_operation op args dbg =
          hence a register. *)
       (Iatomic_fetch_add,
        args @ [Cconst_symbol ("caml_num_domains_running", dbg)])
+  | Catomic_exchange ->
+      (Iatomic_exchange,
+       args @ [Cconst_symbol ("caml_num_domains_running", dbg)])
+  | Catomic_cas ->
+      (Iatomic_cas,
+       args @ [Cconst_symbol ("caml_num_domains_running", dbg)])
   | _ -> super#select_operation op args dbg
 
 (* Recognize float arithmetic with mem *)
diff --git a/asmcomp/arm64/emit.mlp b/asmcomp/arm64/emit.mlp
index dedd4d7a17..b237b9ebe3 100644
--- a/asmcomp/arm64/emit.mlp
+++ b/asmcomp/arm64/emit.mlp
@@ -531,6 +531,8 @@ module Size = struct
     | Lop (Ispecific (Isignext _)) -> 1
     | Lop (Idls_get) -> 1
     | Lop (Iatomic_fetch_add) -> 5
+    | Lop (Iatomic_exchange) -> 4
+    | Lop (Iatomic_cas) -> 9
     | Lop (Ireturn_addr) -> 1
     | Lreloadretaddr -> 0
     | Lreturn -> epilogue_size f + (if top_bits_ignore then 0 else 1)
@@ -1002,6 +1004,36 @@ let emit_instr env i =
     | Lop(Idls_get) ->
         let offset = Domainstate.(idx_of_field Domain_dls_root) * 8 in
         `	ldr	{emit_reg i.res.(0)}, [{emit_reg reg_domain_state_ptr}, {emit_int offset}]\n`
+    | Lop(Iatomic_exchange) ->
+        (* Same LL/SC shape as fetch-and-add, minus the arithmetic. reg_tmp2
+           takes the stlxr status, which must differ from the data register. *)
+        let lbl = new_label() in
+        `{emit_label lbl}:\n`;
+        `	ldaxr	{emit_reg i.res.(0)}, [{emit_reg i.arg.(0)}]\n`;
+        `	stlxr	{emit_wreg reg_tmp2}, {emit_reg i.arg.(1)}, [{emit_reg i.arg.(0)}]\n`;
+        `	cbnz	{emit_wreg reg_tmp2}, {emit_label lbl}\n`;
+        `	dmb	ishst\n`
+    | Lop(Iatomic_cas) ->
+        (* res.(0) holds the loaded value until the very end, where cset
+           overwrites it with the result. The flags set by cmp survive stlxr,
+           cbnz, b and clrex, so both paths land on the same cset.
+           clrex is not architecturally required for an abandoned ldaxr (ARM
+           ARM B2.10.5) but drops the monitor rather than leaving it marked. *)
+        let lbl = new_label() in
+        let lbl_fail = new_label() in
+        let lbl_done = new_label() in
+        `{emit_label lbl}:\n`;
+        `	ldaxr	{emit_reg i.res.(0)}, [{emit_reg i.arg.(0)}]\n`;
+        `	cmp	{emit_reg i.res.(0)}, {emit_reg i.arg.(1)}\n`;
+        `	b.ne	{emit_label lbl_fail}\n`;
+        `	stlxr	{emit_wreg reg_tmp2}, {emit_reg i.arg.(2)}, [{emit_reg i.arg.(0)}]\n`;
+        `	cbnz	{emit_wreg reg_tmp2}, {emit_label lbl}\n`;
+        `	b	{emit_label lbl_done}\n`;
+        `{emit_label lbl_fail}:\n`;
+        `	clrex\n`;
+        `{emit_label lbl_done}:\n`;
+        `	cset	{emit_reg i.res.(0)}, eq\n`;
+        `	dmb	ishst\n`
     | Lop(Iatomic_fetch_add) ->
         (* LL/SC loop, works on baseline ARMv8.0 (no LSE required).
            reg_tmp1 = sum (data), reg_tmp2 = stlxr status (must differ per ARM spec).
diff --git a/asmcomp/arm64/proc.ml b/asmcomp/arm64/proc.ml
index 615a6f314d..d566328da8 100644
--- a/asmcomp/arm64/proc.ml
+++ b/asmcomp/arm64/proc.ml
@@ -271,6 +271,8 @@ let destroyed_at_oper = function
       [| reg_d7 |]            (* d7 / s7 destroyed *)
   | Iop(Iatomic_fetch_add) ->
       [| reg_x16; reg_x17 |]  (* x16=sum, x17=stlxr status in LL/SC loop *)
+  | Iop(Iatomic_exchange | Iatomic_cas) ->
+      [| reg_x17 |]           (* x17=stlxr status in LL/SC loop *)
   | _ -> [||]
 
 let destroyed_at_raise = all_phys_regs
@@ -290,6 +292,7 @@ let max_register_pressure = function
   | Iintoffloat | Ifloatofint
   | Iload{memory_chunk=Single; _} | Istore(Single, _, _) -> [| 23; 31 |]
   | Iatomic_fetch_add -> [| 21; 32 |]  (* x16+x17 used as scratch *)
+  | Iatomic_exchange | Iatomic_cas -> [| 22; 32 |]  (* x17 used as scratch *)
   | _ -> [| 23; 32 |]
 
